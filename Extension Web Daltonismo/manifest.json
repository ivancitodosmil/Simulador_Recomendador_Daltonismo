{
  "manifest_version": 3,
  "name": "Evaluador cromático de dashboards",
  "version": "0.6.10",
  "description": "Evalúa la accesibilidad cromática de dashboards para personas con daltonismo: simula deficiencias, mide contraste WCAG y propone paletas. Todo el cálculo es local.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/iconos/icono-16.png",
    "32": "assets/iconos/icono-32.png",
    "48": "assets/iconos/icono-48.png",
    "128": "assets/iconos/icono-128.png"
  },
  "action": {
    "default_title": "Abrir el evaluador cromático en esta pestaña",
    "default_icon": {
      "16": "assets/iconos/icono-16.png",
      "32": "assets/iconos/icono-32.png",
      "48": "assets/iconos/icono-48.png",
      "128": "assets/iconos/icono-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/ui/panel/panel.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": [
        "src/core/color/conversion.js",
        "src/core/color/diferencia.js",
        "src/core/color/contraste.js",
        "src/core/extraccion/dom-svg.js",
        "src/core/extraccion/canvas.js",
        "src/core/extraccion/consolidacion.js",
        "src/core/simulacion/filtro-svg.js",
        "src/core/simulacion/machado.js",
        "src/core/simulacion/matrices.js",
        "src/core/evaluacion/contraste-wcag.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
